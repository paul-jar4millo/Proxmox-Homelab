# Weekly OS updates for LXC containers, Saturday 10:00 local time.
# Script lives in the Proxmox-Homelab repo; log in /var/log/homelab/.
# Scripts log to files and mail problems themselves; cron only mails if a
# script dies before it starts logging.
MAILTO=root
0 10 * * 6  root  /root/homelab/scripts/update-lxcs.sh
